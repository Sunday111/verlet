{
    "name": "Verlet",
    "enable_lto_globally": true,
    "default_configuration": {
        "build_dir": "build",
        "build_targets": [
            "verlet"
        ],
        "run_target": "verlet",
        "yae-toolchain": {
            "compiler": "clang",
            "linker": "mold",
            "cpplib": "llvm-static"
        },
        "cmake_definitions": {
            "CMAKE_BUILD_TYPE": "Release",
            "CMAKE_C_COMPILER_LAUNCHER": "ccache",
            "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
        }
    },
    "cpp": {
        "standard": "23"
    }
}
